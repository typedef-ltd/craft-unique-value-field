{% import "_includes/forms" as forms %}

{% set readOnly = field.readOnly
    and element is defined
    and element.id
    and value|trim != ''
    and not (name in element.errors|keys)
%}

{% set maximumCharacters = field.getFixedCharacterLength() ?? field.maxChars %}

{% set params = {
    id: id ?? field.getInputId(),
    describedBy: field.describedBy,
    name: name,
    value: value,
    class: [
        'unique_value_field',
        'nicetext',
        readOnly ? 'readonly',
        field.code ? 'code',
    ]|filter,
    maxlength: maximumCharacters,
    showCharsLeft: not readOnly and maximumCharacters is not null,
    placeholder: placeholder,
    required: field.required,
    orientation: orientation ?? null,
    disabled: readOnly ?? null
} %}

<div class="unique_value_field_wrapper{% if readOnly %} readonly{% endif %}">
    {{ forms.text(params) }}
    {% if readOnly %}
        <button type="button" class="unique_value_field_copy_button" aria-label="{{ 'Copy value'|t('app') }}" title="{{ 'Copy value'|t('app') }}">{{ svg('@app/icons/copy.svg') }}</button>
    {% endif %}
</div>
